<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Ocsf</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Strongly-typed .NET SDK for the Open Cybersecurity Schema Framework (OCSF) 1.9.0: event classes, objects, and System.Text.Json serialization with full NativeAOT support.</Description>
    <PackageTags>events;serialization</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The analyzer ships inside this package under analyzers/dotnet/cs; it is not a runtime
       dependency. -->
  <ItemGroup>
    <ProjectReference Include="..\Ocsf.Analyzers\Ocsf.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="..\Ocsf.Analyzers\bin\$(Configuration)\netstandard2.0\Ocsf.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <Import Project="../../Package.Build.props" />

</Project>
