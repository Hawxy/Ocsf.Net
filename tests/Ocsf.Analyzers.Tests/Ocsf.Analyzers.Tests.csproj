<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <!-- The testing package declares 1.x floor versions; pin the Roslyn actually used. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ocsf.Analyzers\Ocsf.Analyzers.csproj" />
    <!-- Pinned to net8.0 so the copied assembly matches the net8.0 reference assemblies the
         analyzer test compilations use. -->
    <ProjectReference Include="..\..\src\Ocsf\Ocsf.csproj" SetTargetFramework="TargetFramework=net8.0" />
  </ItemGroup>

</Project>
